//# sourceMappingURL=SOSCard.js.mapÂ‘Ù3D:\XunAn\XunAn\entry\src\main\ets\model\SOSInfo.etsÙ8D:\XunAn\XunAn\entry\src\main\ets\components\SOSCard.etsÔrB›ªmoduleName±isLocalDependency¯isNodeEntryFile§pkgPath±belongProjectPath§pkgNameªpkgVersion±dependencyPkgInfo¯hostModulesInfo°belongModulePath¬shouldEmitJs¥entryÃÂ´D:\XunAn\XunAn\entry®D:\XunAn\XunAn¥entry¥1.0.0Ô␀␀‘ÔrC’²hostDependencyName®hostModuleNameµ../components/SOSCard¥entry´D:\XunAn\XunAn\entryÃÃÚFimport { SOSInfo, EmergencyLevel, SOSStatus, getCategoryEmoji } from '../model/SOSInfo';

@Component
export struct SOSCard {
  @Prop sos: SOSInfo;
  onAssign?: () => void;
  onDetail?: () => void;

  getLevelColor(): ResourceColor {
    switch (this.sos.level) {
      case EmergencyLevel.HIGH:
        return '#FF4D4F';
      case EmergencyLevel.MEDIUM:
        return '#FAAD14';
      default:
        return '#52C41A';
    }
  }

  getStatusColor(): ResourceColor {
    switch (this.sos.status) {
      case SOSStatus.PENDING:
        return '#FF4D4F';
      case SOSStatus.RESCUING:
        return '#FAAD14';
      default:
        return '#52C41A';
    }
  }

  build() {
    Column() {
      Row() {
        Row({ space: 8 }) {
          Text(getCategoryEmoji(this.sos.category))
            .fontSize(20)
          Text(this.sos.name)
            .fontSize(18)
            .fontWeight(FontWeight.Bold)
        }

        Row({ space: 4 }) {
          Text(this.sos.category)
            .fontSize(11)
            .fontColor('#722ED1')
            .backgroundColor('#F9F0FF')
            .padding({ left: 6, right: 6, top: 2, bottom: 2 })
            .borderRadius(4)
          Text(this.sos.level)
            .fontSize(11)
            .fontColor(Color.White)
            .backgroundColor(this.getLevelColor())
            .padding({ left: 6, right: 6, top: 2, bottom: 2 })
            .borderRadius(4)
        }
      }
      .width('100%')
      .justifyContent(FlexAlign.SpaceBetween)

      Text(`${this.sos.address}`)
        .fontSize(14)
        .fontColor('#666')
        .margin({ top: 4 })
      Text(`${this.sos.description}`)
        .fontSize(14)
        .margin({ top: 4 })
        .maxLines(2)
        .textOverflow({ overflow: TextOverflow.Ellipsis })

      if (this.sos.notes) {
        Text(`ğŸ“ ${this.sos.notes}`)
          .fontSize(12)
          .fontColor('#999')
          .margin({ top: 4 })
          .maxLines(1)
          .textOverflow({ overflow: TextOverflow.Ellipsis })
      }

      Row() {
        Text(`çŠ¶æ€: ${this.sos.status}`)
          .fontSize(12)
          .fontColor(this.getStatusColor())
        Text(this.sos.time)
          .fontSize(12)
          .fontColor('#999')
      }
      .width('100%')
      .justifyContent(FlexAlign.SpaceBetween)
      .margin({ top: 8 })

      if (this.onAssign && this.sos.status === SOSStatus.PENDING) {
        Button('æŒ‡æ´¾æ•‘æ´')
          .width('100%')
          .margin({ top: 8 })
          .type(ButtonType.Capsule)
          .onClick(() => {
            if (this.onAssign) {
              this.onAssign();
            }
          })
      }
      if (this.onDetail) {
        Button('æŸ¥çœ‹è¯¦æƒ…')
          .width('100%')
          .margin({ top: 8 })
          .type(ButtonType.Capsule)
          .backgroundColor('#1890FF')
          .onClick(() => {
            if (this.onDetail) {
              this.onDetail();
            }
          })
      }
    }
    .width('100%')
    .padding(16)
    .backgroundColor(Color.White)
    .borderRadius(12)
    .shadow({ radius: 8, color: 'rgba(0,0,0,0.06)' })
    .margin({ bottom: 12 })
  }
}

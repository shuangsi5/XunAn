¦import { router } from '@kit.ArkUI';
import { SOSInfo, getCategoryEmoji } from '../model/SOSInfo';
import { getSOSList } from '../utils/ApiService';

@Entry
@Component
struct SOSDetailPage {
  @State sos: SOSInfo | null = null;

  aboutToAppear() {
    let params = router.getParams() as Record<string, string>;
    if (params && params['sosId']) {
      getSOSList().then((list) => {
        this.sos = list.find(item => item.id === params['sosId']) || null;
      });
    }
  }

  build() {
    Column() {
      Row() {
        Text('æ±‚æ•‘è¯¦æƒ…')
          .fontSize(20)
          .fontWeight(FontWeight.Bold)
        Button('è¿”å›')
          .onClick(() => router.back())
      }
      .width('100%')
      .justifyContent(FlexAlign.SpaceBetween)
      .padding(16)

      if (this.sos) {
        Scroll() {
          Column({ space: 12 }) {
            DetailRow({ label: 'ç¼–å·', value: this.sos.id })
            DetailRow({ label: 'ç´§æ€¥ç±»å‹', value: `${getCategoryEmoji(this.sos.category)} ${this.sos.category}` })
            DetailRow({ label: 'å§“å', value: this.sos.name })
            DetailRow({ label: 'ç”µè¯', value: this.sos.phone })
            DetailRow({ label: 'åœ°å€', value: this.sos.address })
            DetailRow({ label: 'æè¿°', value: this.sos.description })
            if (this.sos.notes) {
              DetailRow({ label: 'è¡¥å……è¯´æ˜', value: this.sos.notes })
            }
            DetailRow({ label: 'ç´§æ€¥ç¨‹åº¦', value: this.sos.level })
            DetailRow({ label: 'çŠ¶æ€', value: this.sos.status })
            DetailRow({ label: 'æ—¶é—´', value: this.sos.time })
            DetailRow({ label: 'æŒ‡æ´¾æ•‘æ´äººå‘˜', value: this.sos.assignedRescuerName || this.sos.assignedRescuerId || 'æœªæŒ‡æ´¾' })
            DetailRow({ label: 'çº¬åº¦', value: (Number(this.sos.latitude) || 0).toFixed(4) })
            DetailRow({ label: 'ç»åº¦', value: (Number(this.sos.longitude) || 0).toFixed(4) })
          }
          .width('90%')
          .padding(16)
          .backgroundColor(Color.White)
          .borderRadius(12)
          .margin({ top: 16 })
        }
        .layoutWeight(1)
      } else {
        Text('æœªæ‰¾åˆ°ä¿¡æ¯')
          .fontSize(16)
          .fontColor('#999')
          .margin({ top: 40 })
      }
    }
    .width('100%')
    .height('100%')
    .backgroundColor('#F5F5F5')
  }
}

@Component
struct DetailRow {
  label: string = '';
  value: string = '';

  build() {
    Row() {
      Text(this.label)
        .fontSize(14)
        .fontColor('#666')
        .width(90)
      Text(this.value)
        .fontSize(14)
        .fontColor('#333')
        .layoutWeight(1)
    }
    .width('100%')
    .padding({ top: 8, bottom: 8 })
  }
}

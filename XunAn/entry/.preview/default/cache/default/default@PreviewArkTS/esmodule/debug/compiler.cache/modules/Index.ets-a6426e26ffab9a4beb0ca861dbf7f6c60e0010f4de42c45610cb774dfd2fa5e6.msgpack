            .margin({ right: 8 })
            .onClick(() => {
              router.pushUrl({ url: 'pages/ProfilePage' });
            })

          Button('é€€å‡ºç™»å½•')
            .fontSize(13)
            .height(32)
            .backgroundColor('#FF4D4F')
            .fontColor(Color.White)
            .borderRadius(6)
            .onClick(() => this.logout())
        }
        .width('85%')
        .padding({ top: 16, bottom: 4 })

        // åˆ†éš”æç¤º
        Text('è¯·é€‰æ‹©æ‚¨çš„èº«ä»½')
          .fontSize(14)
          .fontColor('#666')
          .width('85%')
          .margin({ top: 8, bottom: 4 })

        // åŠ¨æ€è§’è‰²å¡ç‰‡
        ForEach(this.currentUser!.roles, (role: Role) => {
          Column({ space: 4 }) {
            Text(getRoleEmoji(role))
              .fontSize(40)
            Text(getRoleLabel(role))
              .fontSize(18)
              .fontWeight(FontWeight.Bold)
            Text(getRoleSubtitle(role))
              .fontSize(11)
              .fontColor('#999')
          }
          .width('80%')

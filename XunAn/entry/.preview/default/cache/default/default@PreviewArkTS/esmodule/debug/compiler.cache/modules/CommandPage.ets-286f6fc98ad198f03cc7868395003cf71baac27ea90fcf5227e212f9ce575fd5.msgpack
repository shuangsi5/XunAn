    Stack() {
      Column() {
        Row() {
          Text('åº”æ€¥æŒ‡æŒ¥éƒ¨')
            .fontSize(20)
            .fontWeight(FontWeight.Bold)
          Button('è¿”å›')
            .onClick(() => router.back())
        }
        .width('100%')
        .justifyContent(FlexAlign.SpaceBetween)
        .padding(16)

        Row({ space: 12 }) {
          Column() {
            Text(`${this.getStats().pending}`)
              .fontSize(28)
              .fontColor('#FF4D4F')
              .fontWeight(FontWeight.Bold)
            Text('å¾…æ•‘æ´')
              .fontSize(12)
              .fontColor('#666')
          }
          .layoutWeight(1)
          .padding(12)
          .backgroundColor(Color.White)
          .borderRadius(8)

          Column() {
            Text(`${this.getStats().rescuing}`)
              .fontSize(28)
              .fontColor('#FAAD14')
              .fontWeight(FontWeight.Bold)
            Text('æ•‘æ´ä¸­')
              .fontSize(12)
              .fontColor('#666')
          }
          .layoutWeight(1)
          .padding(12)
          .backgroundColor(Color.White)
          .borderRadius(8)

          Column() {
            Text(`${this.getStats().completed}`)
              .fontSize(28)
              .fontColor('#52C41A')
              .fontWeight(FontWeight.Bold)
            Text('å·²å®Œæˆ')
              .fontSize(12)
              .fontColor('#666')
          }
          .layoutWeight(1)
          .padding(12)
          .backgroundColor(Color.White)
          .borderRadius(8)
        }
        .width('90%')
        .margin({ top: 8, bottom: 16 })

        Button('æŸ¥çœ‹å…¨å±€åœ°å›¾')
          .width('90%')
          .margin({ bottom: 16 })
          .type(ButtonType.Capsule)
          .onClick(() => {
            router.pushUrl({ url: 'pages/MapPage' });
          })

        Text('æ±‚æ•‘ä¿¡æ¯åˆ—è¡¨')
          .fontSize(16)
          .fontWeight(FontWeight.Bold)
          .width('90%')
          .margin({ bottom: 12 })

        List({ space: 12 }) {
          ForEach(this.sosList, (item: SOSInfo) => {
            ListItem() {
              SOSCard({
                sos: item,
                onAssign: item.status === SOSStatus.PENDING ? ((): void => this.openAssign(item)) : undefined,
                onDetail: (): void => {
                  router.pushUrl({

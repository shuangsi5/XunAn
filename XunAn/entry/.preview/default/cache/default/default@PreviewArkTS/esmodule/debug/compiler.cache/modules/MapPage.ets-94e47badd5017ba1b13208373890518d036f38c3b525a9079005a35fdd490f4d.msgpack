    AppStorage.setOrCreate('pickedLat', this.targetLat);
    AppStorage.setOrCreate('pickedLng', this.targetLng);
    // åå‘åœ°ç†ç¼–ç è·å–çœå¸‚åŒºç­‰è¯¦ç»†åœ°å€
    let geoAddr = await reverseGeocode(this.targetLat, this.targetLng);
    let addr: string;
    if (geoAddr) {
      addr = `${geoAddr} (çº¬åº¦ ${this.targetLat.toFixed(5)}, ç»åº¦ ${this.targetLng.toFixed(5)})`;
    } else {
      addr = `çº¬åº¦ ${this.targetLat.toFixed(5)}, ç»åº¦ ${this.targetLng.toFixed(5)}`;
    }
    AppStorage.setOrCreate('pickedAddress', addr);
    this.locating = false;
    router.back();
  }

  build() {
    Column() {
      Row() {
        Text(this.title)
          .fontSize(18)
          .fontWeight(FontWeight.Bold)
        Row({ space: 8 }) {
          if (this.pickerMode) {
            Button(this.locating ? 'å®šä½ä¸­â€¦' : 'ç¡®è®¤æ­¤ä½ç½®')
              .fontSize(14)
              .height(36)
              .type(ButtonType.Capsule)
              .backgroundColor(this.locating ? '#999' : '#FF4D4F')
              .fontColor(Color.White)
              .enabled(!this.locating)
              .onClick(() => this.confirmLocation())
          }
          Button('è¿”å›')
            .fontSize(14)
            .height(36)
            .onClick(() => router.back())
        }
      }
      .width('100%')
      .justifyContent(FlexAlign.SpaceBetween)
      .padding(16)

      MapComponent({
        markers: this.markers,
        polylines: this.polylines,
        myLocationEnabled: this.showMyLocation,
        initialLat: this.mapLat,
        initialLng: this.mapLng,
        zoomLevel: this.mapZoom
      })
        .layoutWeight(1)

      if (this.pickerMode) {
        Row() {
          Text(this.locating
            ? 'ğŸ“ æ­£åœ¨è·å–æ‚¨çš„ä½ç½®â€¦'
            : 'ğŸ“ è“è‰²åœ†ç‚¹ä¸ºæ‚¨çš„å½“å‰ä½ç½®ï¼Œç¡®è®¤æ— è¯¯åç‚¹å‡»ä¸Šæ–¹æŒ‰é’®')
            .fontSize(12)
            .fontColor('#666')
            .textAlign(TextAlign.Center)
        }
        .width('100%')
        .padding(12)
        .backgroundColor('#FFFBE6')
      }

      if (this.sosMode) {
        Row() {
          Text(this.locating
            ? 'ğŸ“ æ­£åœ¨è·å–ä½ç½®ä¿¡æ¯â€¦'
            : 'ğŸ“ çº¢è‰²æ ‡è®°ä¸ºæ±‚æ•‘ä½ç½®ï¼Œè“è‰²æ ‡è®°ä¸ºæ‚¨å½“å‰æ‰€åœ¨ä½ç½®')
            .fontSize(12)
            .fontColor('#666')
            .textAlign(TextAlign.Center)
        }
        .width('100%')
        .padding(12)
        .backgroundColor('#E6F7FF')
      }
    }
    .width('100%')
    .height('100%')
  }
}

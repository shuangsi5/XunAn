import { SOSInfo, SOSStatus } from '../model/SOSInfo';
import { RescuerInfo } from '../model/RescuerInfo';
import { getSOSList, getRescuerList, completeTask, getLoggedInPhone } from '../utils/ApiService';
import { SOSCard } from '../components/SOSCard';

@Entry
@Component
struct RescuerPage {
  @State currentIndex: number = 0;
  @State taskHallList: SOSInfo[] = [];
  @State myTasks: SOSInfo[] = [];
  @State rescuer: RescuerInfo | null = null;

  aboutToAppear() {
    let phone = getLoggedInPhone();
    getRescuerList().then((list) => {
      this.rescuer = list.find(r => String(r.phone) === phone) || null;
      this.refresh();
    }).catch((err: Error) => {
      console.error('è·å–æ•‘æ´äººå‘˜åˆ—è¡¨å¤±è´¥', err);
      this.refresh();
    });
  }

  async refresh() {
    let allSos = await getSOSList();
    let rescuerId = this.rescuer ? String(this.rescuer.id) : '';
    this.taskHallList = allSos.filter(
      s => s.status === SOSStatus.PENDING || String(s.assignedRescuerId) === rescuerId
    );
    if (this.rescuer) {
      this.myTasks = allSos.filter(
        s => String(s.assignedRescuerId) === rescuerId && s.status !== SOSStatus.COMPLETED
      );
    }
  }

  navigateToMap(sos: SOSInfo) {
    router.pushUrl({
      url: 'pages/MapPage',
      params: {
        targetLat: sos.latitude,
        targetLng: sos.longitude,
        title: sos.name,
        sosId: sos.id
      }
    });
  }

  async complete(sos: SOSInfo) {
    await completeTask(sos.id);
    this.refresh();
  }

  build() {
    Column() {
      Row() {
        Text('æ•‘æ´ç«¯')
          .fontSize(20)
          .fontWeight(FontWeight.Bold)
        Button('è¿”å›')
          .onClick(() => router.back())
      }
      .width('100%')
      .justifyContent(FlexAlign.SpaceBetween)
      .padding(16)

      Tabs({ barPosition: BarPosition.End }) {
        TabContent() {
          List({ space: 12 }) {
            ForEach(
              this.taskHallList,
              (item: SOSInfo) => {
                ListItem() {
                  SOSCard({
                    sos: item,
                    onDetail: (): void => this.navigateToMap(item)
                  })
                }
                .width('100%')
              },
              (item: SOSInfo) => item.id
            )
          }
          .width('100%')
          .alignListItem(ListItemAlign.Center)
          .layoutWeight(1)
          .padding({ left: 12, right: 12, bottom: 16 })
        }
        .tabBar('ä»»åŠ¡å¤§å…')

        TabContent() {
          if (this.myTasks.length === 0) {
            Text('æš‚æ— ä»»åŠ¡')
              .fontSize(16)
              .fontColor('#999')
              .margin({ top: 40 })
          } else {
            List({ space: 12 }) {
              ForEach(this.myTasks, (item: SOSInfo) => {
                ListItem() {
                  Column() {
                    SOSCard({
                      sos: item,
                      onDetail: (): void => this.navigateToMap(item)
                    })
                    Button('å®Œæˆä»»åŠ¡')
                      .width('100%')
                      .margin({ top: 8 })
                      .type(ButtonType.Capsule)
                      .backgroundColor('#52C41A')
                      .onClick(() => this.complete(item))
                  }
                  .width('100%')
                }
                .width('100%')
              }, (item: SOSInfo) => item.id)
            }
            .width('100%')
            .alignListItem(ListItemAlign.Center)
            .layoutWeight(1)
            .padding({ left: 12, right: 12, bottom: 16 })
          }
        }
        .tabBar('æˆ‘çš„ä»»åŠ¡')
      }
      .width('100%')
      .layoutWeight(1)
    }
    .width('100%')
    .height('100%')
    .backgroundColor('#F5F5F5')
  }
}

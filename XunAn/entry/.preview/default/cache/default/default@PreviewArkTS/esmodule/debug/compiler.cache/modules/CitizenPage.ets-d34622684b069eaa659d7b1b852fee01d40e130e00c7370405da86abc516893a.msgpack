        .margin({ top: 20, bottom: 8 })

        // åˆ†éš”
        Row()
          .width('90%').height(1)
          .backgroundColor('#E8E8E8')
          .margin({ top: 8, bottom: 4 })

        // è®°å½•æ ‡é¢˜
        Text('æˆ‘çš„æ±‚æ•‘è®°å½•')

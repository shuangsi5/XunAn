        // é•¿æŒ‰æ±‚æ•‘æŒ‰é’®åŒº
        Column({ space: 8 }) {
          Text('ç´§æ€¥æƒ…å†µè¯·é•¿æŒ‰ä¸‹æ–¹æŒ‰é’®')
            .fontSize(13)

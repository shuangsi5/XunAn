              }
            })
            .animation({ duration: 200 })
          }
          .width(140).height(140)

          if (this.isPressing && this.sosProgress < 100) {
            Text('âš ï¸ è¯·æŒç»­æŒ‰ä½3ç§’ï¼Œæ¾æ‰‹å°†å–æ¶ˆ')

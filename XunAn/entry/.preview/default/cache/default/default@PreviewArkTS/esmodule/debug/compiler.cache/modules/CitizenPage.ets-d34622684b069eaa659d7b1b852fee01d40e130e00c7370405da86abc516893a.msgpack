    async fetchAndFillLocation() {
        let ctx = getContext(this);
        let pos = await getCurrentPosition(ctx);
        this.formLat = pos.latitude;
        this.formLng = pos.longitude;
        if (pos.address) {
            this.formAddress = pos.address;
        }
    }
    handleTouchUp() {
        clearInterval(this.pressTimer);

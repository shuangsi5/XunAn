//# sourceMappingURL=MapComponent.js.mapÂ‘ÙX␀hvigor_ignore_D:_DevEco Studio_sdk_default_hms_ets_api_@hms.core.map.MapComponent.d.etsÙ=D:\XunAn\XunAn\entry\src\main\ets\components\MapComponent.etsÔrB›ªmoduleName±isLocalDependency¯isNodeEntryFile§pkgPath±belongProjectPath§pkgNameªpkgVersion±dependencyPkgInfo¯hostModulesInfo°belongModulePath¬shouldEmitJs¥entryÃÂ´D:\XunAn\XunAn\entry®D:\XunAn\XunAn¥entry¥1.0.0Ô␀␀‘ÔrC’²hostDependencyName®hostModuleNameº../components/MapComponent¥entry´D:\XunAn\XunAn\entryÃÃÚñimport { MapComponent as HMSMap, map, mapCommon } from '@kit.MapKit';
import { AsyncCallback } from '@kit.BasicServicesKit';
import { MapMarker, MapPolyline } from '../model/MapTypes';

@Component
export struct MapComponent {
  @Prop markers: MapMarker[] = [];
  @Prop polylines: MapPolyline[] = [];
  @Prop myLocationEnabled: boolean = false;
  @Prop initialLat: number = 39.9100;
  @Prop initialLng: number = 116.4000;
  @Prop zoomLevel: number = 12;
  private mapOptions?: mapCommon.MapOptions;
  private mapController?: map.MapComponentController;

  aboutToAppear(): void {
    this.mapOptions = {
      position: {
        target: {
          latitude: this.initialLat,
          longitude: this.initialLng
        },
        zoom: this.zoomLevel
      }
    };
  }

  build() {
    Stack() {
      HMSMap({
        mapOptions: this.mapOptions,
        mapCallback: (err, controller) => {
          if (!err && controller) {
            this.mapController = controller;
            this.markers.forEach(marker => {
              this.mapController?.addMarker(marker);
            });
            this.polylines.forEach(line => {
              this.mapController?.addPolyline(line);
            });
            if (this.myLocationEnabled) {
              this.mapController?.setMyLocationEnabled(true);
              this.mapController?.setMyLocationControlsEnabled(true);
            }
          }
        }
      })
        .width('100%')
        .height('100%')
    }
    .width('100%')
    .height('100%')
  }
}

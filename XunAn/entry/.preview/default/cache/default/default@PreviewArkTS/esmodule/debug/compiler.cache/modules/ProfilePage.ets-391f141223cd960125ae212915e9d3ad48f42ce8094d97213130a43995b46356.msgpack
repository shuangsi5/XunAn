          .backgroundColor(Color.White)
          .borderRadius(12)

          // â”€â”€ é”™è¯¯ä¿¡æ¯ â”€â”€
          if (this.errorMsg) {
            Text(this.errorMsg)
              .fontSize(13)
              .fontColor('#FF4D4F')
              .width('85%')
              .margin({ top: 8 })
          }

          // â”€â”€ ä¿å­˜æŒ‰é’® â”€â”€
          Button('ä¿å­˜ä¿®æ”¹')

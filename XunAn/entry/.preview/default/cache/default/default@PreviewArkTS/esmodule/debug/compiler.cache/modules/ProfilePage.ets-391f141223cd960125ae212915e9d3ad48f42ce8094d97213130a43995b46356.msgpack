                .fontSize(14)
                .fontColor('#666')
            }
            .width('100%')

            TextInput({ placeholder: 'è¯·è¾“å…¥å•ä½ï¼ˆé€‰å¡«ï¼‰', text: $$this.unit })
              .width('100%')
              .height(44)
              .fontSize(15)
              .backgroundColor('#F7F8FA')
              .borderRadius(8)
              .padding({ left: 12, right: 12 })
          }
          .width('100%')

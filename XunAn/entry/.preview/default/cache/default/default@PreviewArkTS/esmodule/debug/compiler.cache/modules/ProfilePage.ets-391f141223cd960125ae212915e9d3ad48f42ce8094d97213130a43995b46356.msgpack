// åªè¯»ä¿¡æ¯å¡ç‰‡
@Component
struct InfoCard {
  @Prop icon: string = '';
  @Prop label: string = '';
  @Prop value: string = '';
  @Prop readonly: boolean = false;

  build() {
    Row({ space: 10 }) {
      Text(this.icon)
        .fontSize(16)
      Column({ space: 4 }) {
        Text(this.label)
          .fontSize(12)
          .fontColor('#999')
        Text(this.value || 'æœªè®¾ç½®')
          .fontSize(15)
          .fontColor(this.readonly ? '#999' : '#333')
      }
      .alignItems(HorizontalAlign.Start)

      Blank()

      if (this.readonly) {
        Text('ä¸å¯ä¿®æ”¹')
          .fontSize(11)
          .fontColor('#BBB')
          .padding({ left: 8, right: 8, top: 2, bottom: 2 })
          .backgroundColor('#F5F5F5')
          .borderRadius(4)
      }
    }
    .width('100%')
    .padding(16)
    .margin({ top: 12, left: 12, right: 12 })
    .backgroundColor(Color.White)
    .borderRadius(12)
  }
}

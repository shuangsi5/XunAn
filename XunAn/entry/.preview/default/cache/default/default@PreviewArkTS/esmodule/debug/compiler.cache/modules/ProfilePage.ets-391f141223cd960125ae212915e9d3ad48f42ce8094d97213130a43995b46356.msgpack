            .borderRadius(12)
            .margin({ top: 24, bottom: 30 })
            .shadow({ radius: 8, color: 'rgba(24,144,255,0.3)' })
            .onClick(() => this.handleSave())

          Blank().height(16)
        }
        .width('100%')
        .alignItems(HorizontalAlign.Center)
      }
      .layoutWeight(1)
      .scrollBar(BarState.Off)
    }
    .width('100%')
    .height('100%')
    .backgroundColor('#F5F5F5')
  }

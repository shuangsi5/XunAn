import { User } from '../model/User';
import { getLoggedInPhone, getUserByPhone, updateUserProfile } from '../utils/ApiService';

@Entry
@Component
struct ProfilePage {
  @State phone: string = '';
  @State name: string = '';
  @State password: string = '';
  @State unit: string = '';
  @State roles: string = '';
  @State errorMsg: string = '';

  aboutToAppear(): void {
    let phone = getLoggedInPhone();
    if (phone) {
      getUserByPhone(phone).then((user) => {
        if (user) {
          this.phone = user.phone;
          this.name = user.name;
          this.password = user.password;
          this.unit = user.unit || '';
          this.roles = user.roles.join(' / ');
        }
      });
    }
  }

  async handleSave(): Promise<void> {
    this.errorMsg = '';
    if (!this.name.trim()) {
      this.errorMsg = 'å§“åä¸èƒ½ä¸ºç©º';
      return;
    }
    if (!this.password.trim()) {
      this.errorMsg = 'å¯†ç ä¸èƒ½ä¸ºç©º';
      return;
    }
    if (this.password.length < 4) {
      this.errorMsg = 'å¯†ç è‡³å°‘4ä½';
      return;
    }
    let success = await updateUserProfile(this.phone, this.name.trim(), this.password.trim(), this.unit.trim());
    if (success) {
      promptAction.showToast({ message: 'ä¿å­˜æˆåŠŸ', duration: 2000 });
      router.back();
    } else {
      this.errorMsg = 'ä¿å­˜å¤±è´¥ï¼Œè¯·é‡è¯•';
    }
  }

  build() {
    Column() {
      // æ ‡é¢˜æ 
      Row() {
        Button('â† è¿”å›')
          .fontSize(15)
          .backgroundColor(Color.Transparent)
          .fontColor('#1890FF')
          .onClick(() => router.back())
        Blank()
        Text('ä¸ªäººä¸­å¿ƒ')
          .fontSize(20)
          .fontWeight(FontWeight.Bold)
        Blank()
        // å ä½ä¿æŒæ ‡é¢˜å±…ä¸­
        Button('â† è¿”å›')
          .fontSize(15)
          .backgroundColor(Color.Transparent)
          .fontColor(Color.Transparent)
      }
      .width('90%')
      .margin({ top: 16, bottom: 16 })

      Scroll() {
        Column({ space: 0 }) {

          // â”€â”€ å¤´åƒåŒºåŸŸ â”€â”€
          Column({ space: 8 }) {
            Text('ğŸ‘¤')
              .fontSize(48)
            Text(this.name || 'ç”¨æˆ·')
              .fontSize(20)
              .fontWeight(FontWeight.Bold)
              .fontColor('#333')
            Text(this.roles)
              .fontSize(13)
              .fontColor('#999')
          }
          .width('100%')
          .padding({ top: 24, bottom: 24 })
          .alignItems(HorizontalAlign.Center)

          // â”€â”€ æ‰‹æœºå·ï¼ˆä¸å¯ä¿®æ”¹ï¼‰ â”€â”€
          InfoCard({ icon: 'ğŸ“±', label: 'æ‰‹æœºå·', value: this.phone, readonly: true })

          // â”€â”€ å§“å â”€â”€
          Column({ space: 8 }) {
            Row({ space: 8 }) {
              Text('âœï¸')
                .fontSize(16)
              Text('å§“å')
                .fontSize(14)
                .fontColor('#666')
            }
            .width('100%')

            TextInput({ placeholder: 'è¯·è¾“å…¥å§“å', text: $$this.name })
              .width('100%')
              .height(44)
              .fontSize(15)
              .backgroundColor('#F7F8FA')
              .borderRadius(8)
              .padding({ left: 12, right: 12 })
          }
          .width('100%')
          .padding(16)
          .margin({ top: 12, left: 12, right: 12 })
          .backgroundColor(Color.White)
          .borderRadius(12)

          // â”€â”€ å¯†ç  â”€â”€
          Column({ space: 8 }) {
            Row({ space: 8 }) {
              Text('ğŸ”’')
                .fontSize(16)
              Text('å¯†ç ')
                .fontSize(14)
                .fontColor('#666')
            }
            .width('100%')

            TextInput({ placeholder: 'è¯·è¾“å…¥å¯†ç ', text: $$this.password })
              .width('100%')
              .height(44)
              .fontSize(15)
              .type(InputType.Password)
              .maxLength(20)
              .backgroundColor('#F7F8FA')
              .borderRadius(8)
              .padding({ left: 12, right: 12 })
          }
          .width('100%')
          .padding(16)
          .margin({ top: 12, left: 12, right: 12 })
          .backgroundColor(Color.White)
          .borderRadius(12)

          // â”€â”€ æ‰€å±å•ä½ â”€â”€
          Column({ space: 8 }) {
            Row({ space: 8 }) {
              Text('ğŸ¢')

            .fontSize(16)
            .fontWeight(FontWeight.Bold)
            .fontColor(AppColors.textPrimary)
            .maxLines(1)
            .textOverflow({ overflow: TextOverflow.Ellipsis })
        }
        .layoutWeight(1)

        // å³ä¾§ï¼šç±»å‹ + çº§åˆ« + è¡€å‹
        Row({ space: 6 }) {
          Text(this.sos.category)
            .fontSize(10)
            .fontColor(AppColors.textTertiary)
            .backgroundColor(AppColors.bgSecondary)
            .padding({ left: 6, right: 6, top: 2, bottom: 2 })
            .borderRadius(4)

          Text(this.sos.level)
            .fontSize(10)
            .fontColor(Color.White)
            .backgroundColor(this.getLevelColor())
            .padding({ left: 6, right: 6, top: 2, bottom: 2 })
            .borderRadius(4)

          // ã€è¡€å‹æ ‡ç­¾ã€‘æ”¾åœ¨â€œç´§æ€¥â€å³ä¾§
          if (this.sos.bloodType) {
            Text(this.sos.bloodType)
              .fontSize(10)
              .fontColor(this.sos.bloodType === 'æœªçŸ¥' ? AppColors.textTertiary : Color.White)
              .backgroundColor(this.sos.bloodType === 'æœªçŸ¥' ? AppColors.bgSecondary : '#E53935')
              .padding({ left: 6, right: 6, top: 2, bottom: 2 })
              .borderRadius(4)
          }
        }
      }
      .width('100%')
      .alignItems(VerticalAlign.Top)

      // åœ°å€
      Row({ space: 4 }) {
        Text('ğŸ“')
          .fontSize(12)
        Text(this.sos.address)
          .fontSize(13)
          .fontColor(AppColors.textSecondary)
          .layoutWeight(1)
          .maxLines(1)
          .textOverflow({ overflow: TextOverflow.Ellipsis })
      }
      .width('100%')
      .margin({ top: 8 })

      // æè¿°
      Text(this.sos.description)
        .fontSize(14)
        .fontColor(AppColors.textPrimary)
        .margin({ top: 6 })
        .maxLines(2)
        .textOverflow({ overflow: TextOverflow.Ellipsis })

      // è¡¥å……è¯´æ˜
      if (this.sos.notes) {
        Text(`ğŸ“ ${this.sos.notes}`)
          .fontSize(12)
          .fontColor(AppColors.textTertiary)
          .margin({ top: 6 })
          .maxLines(1)
          .textOverflow({ overflow: TextOverflow.Ellipsis })
      }

      // åº•éƒ¨ï¼šçŠ¶æ€æ ‡ç­¾ + æ—¶é—´
      Row() {
        Text(this.sos.status)
          .fontSize(11)
          .fontColor(getStatusColor(this.sos.status))
          .backgroundColor(getStatusBg(this.sos.status))
          .padding({ left: 8, right: 8, top: 2, bottom: 2 })
          .borderRadius(4)
        Blank()
        Text(this.sos.time)
          .fontSize(11)
          .fontColor(AppColors.textTertiary)
      }
      .width('100%')
      .margin({ top: 10 })

      // æ“ä½œæŒ‰é’®
      if (this.onAssign && this.sos.status === SOSStatus.PENDING) {
        Button('æŒ‡æ´¾æ•‘æ´')
          .width('100%')
          .height(36)
          .fontSize(14)
          .fontWeight(FontWeight.Medium)
          .fontColor(Color.White)
          .backgroundColor(AppColors.primary)
          .borderRadius(18)
          .margin({ top: 12 })
          .onClick(() => {
            if (this.onAssign) {
              this.onAssign();
            }
          })
      }
      if (this.onDetail) {
        Button('æŸ¥çœ‹è¯¦æƒ…')
          .width('100%')
          .height(36)
          .fontSize(14)
          .fontWeight(FontWeight.Medium)
          .fontColor(AppColors.primary)
          .backgroundColor(AppColors.primaryLight)
          .borderRadius(18)
          .margin({ top: this.onAssign && this.sos.status === SOSStatus.PENDING ? 8 : 12 })
          .onClick(() => {
            if (this.onDetail) {
              this.onDetail();
            }
          })
      }
    }
    .width('100%')
    .padding(16)

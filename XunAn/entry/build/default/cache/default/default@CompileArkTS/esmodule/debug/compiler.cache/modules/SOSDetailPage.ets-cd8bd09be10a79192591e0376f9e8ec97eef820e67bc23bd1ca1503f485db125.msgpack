@Entry
@Component
struct SOSDetailPage {
  @State sos: SOSInfo | null = null;

  aboutToAppear() {
    let params = router.getParams() as Record<string, string>;
    if (params && params['sosId']) {
      getSOSList().then((list) => {
        this.sos = list.find(item => item.id === params['sosId']) || null;
      });
    }
  }

  // é¸¿è’™åŽŸç”Ÿå¼é¡µé¢è½¬åœºï¼špush ä»Žå³æ»‘å…¥ã€pop ä»Žå·¦è¿”å›žï¼Œæ—§é¡µé¢æ·¡å‡ºå½¢æˆè§†å·®
  pageTransition() {
    PageTransitionEnter({ duration: 400, curve: Curve.Friction, type: RouteType.Push })
      .slide(SlideEffect.Right)
    PageTransitionExit({ duration: 400, curve: Curve.Friction, type: RouteType.Push })
      .slide(SlideEffect.Left)
      .opacity(0.6)
    PageTransitionEnter({ duration: 400, curve: Curve.Friction, type: RouteType.Pop })
      .slide(SlideEffect.Left)
    PageTransitionExit({ duration: 400, curve: Curve.Friction, type: RouteType.Pop })
      .slide(SlideEffect.Right)
      .opacity(0.6)
  }

  build() {
    Column() {
      // æ ‡é¢˜æ 
      Row() {
        Button('â†')
          .fontSize(20)
          .backgroundColor(Color.Transparent)
          .fontColor(AppColors.textPrimary)
          .width(40)
          .height(40)
          .onClick(() => router.back())
        Blank()
        Text('æ±‚æ•‘è¯¦æƒ…')
          .fontSize(18)
          .fontWeight(FontWeight.Bold)
          .fontColor(AppColors.textPrimary)
        Blank()
        Row()
          .width(40)
          .height(40)
      }
      .width('100%')
      .justifyContent(FlexAlign.SpaceBetween)
      .alignItems(VerticalAlign.Center)
      .padding({ left: 8, right: 8, top: 12, bottom: 12 })

      if (this.sos) {
        Scroll() {
          Column({ space: 0 }) {
            // çŠ¶æ€æ‘˜è¦å¡
            Column({ space: 8 }) {
              Text(`${getCategoryEmoji(this.sos.category)} ${this.sos.name}`)
                .fontSize(20)
                .fontWeight(FontWeight.Bold)
                .fontColor(AppColors.textPrimary)
              Text(this.sos.status)
                .fontSize(13)
                .fontColor(getStatusColor(this.sos.status))
                .backgroundColor(getStatusBg(this.sos.status))
                .padding({ left: 10, right: 10, top: 3, bottom: 3 })
                .borderRadius(6)
            }
            .width('90%')
            .padding(20)
            .backgroundColor(AppColors.card)
            .borderRadius(16)
            .margin({ top: 8 })
            .alignItems(HorizontalAlign.Center)

            // è¯¦æƒ…åˆ—è¡¨
            Column({ space: 0 }) {
              DetailRow({ label: 'ç¼–å·', value: this.sos.id })
              DetailRow({ label: 'ç´§æ€¥ç±»åž‹', value: `${getCategoryEmoji(this.sos.category)} ${this.sos.category}` })
              DetailRow({ label: 'å§“å', value: this.sos.name })
              DetailRow({ label: 'ç”µè¯', value: this.sos.phone })
              DetailRow({ label: 'è¡€åž‹', value: this.sos.bloodType || 'æœªçŸ¥' })  // ã€æ–°å¢žã€‘
              DetailRow({ label: 'åœ°å€', value: this.sos.address })
              DetailRow({ label: 'æè¿°', value: this.sos.description })
              if (this.sos.notes) {
                DetailRow({ label: 'è¡¥å……è¯´æ˜Ž', value: this.sos.notes })
              }
              if (this.sos.imageUrl) {
                Column({ space: 8 }) {
                  Text('çŽ°åœºç…§ç‰‡').fontSize(14).fontColor(AppColors.textSecondary).width('100%')
                  Image(this.sos.imageUrl)
                    .width('100%')
                    .height(200)
                    .objectFit(ImageFit.Cover)
                    .borderRadius(12)
                }
                .width('100%')
                .padding({ top: 12, bottom: 12 })
                .border({ width: { bottom: 0.5 }, color: AppColors.divider })
              }
              DetailRow({ label: 'ç´§æ€¥ç¨‹åº¦', value: this.sos.level })
              DetailRow({ label: 'çŠ¶æ€', value: this.sos.status })
              DetailRow({ label: 'æ—¶é—´', value: this.sos.time })
              DetailRow({ label: 'æŒ‡æ´¾æ•‘æ´äººå‘˜', value: this.sos.assignedRescuerName || this.sos.assignedRescuerId || 'æœªæŒ‡æ´¾' })
              DetailRow({ label: 'çº¬åº¦', value: (Number(this.sos.latitude) || 0).toFixed(4) })
              DetailRow({ label: 'ç»åº¦', value: (Number(this.sos.longitude) || 0).toFixed(4) })
            }
            .width('90%')
            .padding({ left: 16, right: 16, top: 8, bottom: 8 })
            .backgroundColor(AppColors.card)
            .borderRadius(16)
            .margin({ top: 12, bottom: 24 })
          }
          .width('100%')
          .alignItems(HorizontalAlign.Center)
        }
        .layoutWeight(1)
        .scrollBar(BarState.Off)
      } else {
        Text('æœªæ‰¾åˆ°ä¿¡æ¯')
          .fontSize(16)
          .fontColor(AppColors.textTertiary)
          .margin({ top: 40 })
      }
    }
    .width('100%')
    .height('100%')
    .backgroundColor(AppColors.bg)
  }
}

@Component
struct DetailRow {
  label: string = '';
  value: string = '';

  build() {
    Row() {
      Text(this.label)
        .fontSize(14)
        .fontColor(AppColors.textSecondary)
        .width(96)
      Text(this.value)
        .fontSize(14)
        .fontColor(AppColors.textPrimary)
        .layoutWeight(1)
        .textAlign(TextAlign.End)
    }
    .width('100%')
    .padding({ top: 12, bottom: 12 })
    .border({ width: { bottom: 0.5 }, color: AppColors.divider })
  }

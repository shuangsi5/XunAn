      return;
    }
    if (this.selectedRoles.length === 0) {
      this.errorMsg = 'è¯·è‡³å°‘é€‰æ‹©ä¸€ä¸ªèº«ä»½';
      return;
    }
    this.isLoading = true;
    let unit = this.hasNonCitizenRole() ? this.unitOptions[this.unitIndex].value : '';
    let success = await registerUser(phone, this.name.trim(), this.password.trim(), this.selectedRoles, unit);
    this.isLoading = false;
    if (success) {
      promptAction.showToast({ message: 'æ³¨å†ŒæˆåŠŸ', duration: 2000 });
      router.back();
    } else {
      this.errorMsg = 'æ³¨å†Œå¤±è´¥ï¼Œè¯·æ£€æŸ¥ç½‘ç»œåŽé‡è¯•';
    }
  }

  // é¸¿è’™åŽŸç”Ÿå¼é¡µé¢è½¬åœºï¼špush ä»Žå³æ»‘å…¥ã€pop ä»Žå·¦è¿”å›žï¼Œæ—§é¡µé¢æ·¡å‡ºå½¢æˆè§†å·®
  pageTransition() {
    PageTransitionEnter({ duration: 400, curve: Curve.Friction, type: RouteType.Push })
      .slide(SlideEffect.Right)
    PageTransitionExit({ duration: 400, curve: Curve.Friction, type: RouteType.Push })
      .slide(SlideEffect.Left)
      .opacity(0.6)
    PageTransitionEnter({ duration: 400, curve: Curve.Friction, type: RouteType.Pop })
      .slide(SlideEffect.Left)
    PageTransitionExit({ duration: 400, curve: Curve.Friction, type: RouteType.Pop })
      .slide(SlideEffect.Right)
      .opacity(0.6)
  }

  build() {
    Column() {
      // æ ‡é¢˜æ 
      Row() {
        Button('â†')
          .fontSize(20)
          .backgroundColor(Color.Transparent)
          .fontColor(AppColors.textPrimary)
          .width(40)
          .height(40)
          .onClick(() => router.back())
        Blank()
        Text('æ³¨å†Œè´¦å·')
          .fontSize(18)
          .fontWeight(FontWeight.Bold)
          .fontColor(AppColors.textPrimary)
        Blank()
        Row()
          .width(40)
          .height(40)
      }
      .width('100%')
      .justifyContent(FlexAlign.SpaceBetween)
      .alignItems(VerticalAlign.Center)
      .padding({ left: 8, right: 8, top: 12, bottom: 12 })

      Scroll() {
        Column({ space: 12 }) {
          // è§’è‰²é€‰æ‹©ï¼ˆå¤šé€‰ï¼‰
          Text('é€‰æ‹©èº«ä»½ï¼ˆå¯å¤šé€‰ï¼‰')
            .fontSize(14)
            .fontWeight(FontWeight.Medium)
            .fontColor(AppColors.textSecondary)
            .width('90%')

          Row({ space: 10 }) {
            ForEach(
              this.roleOptions,
              (option: RoleOption) => {
                Column({ space: 4 }) {
                  Text(option.emoji)
                    .fontSize(24)
                  Text(option.label)
                    .fontSize(13)
                    .fontWeight(FontWeight.Medium)
                    .fontColor(this.selectedRoles.includes(option.role) ? option.color : AppColors.textSecondary)
                  if (this.selectedRoles.includes(option.role)) {
                    Text('âœ“')
                      .fontSize(10)
                      .fontColor(option.color)
                  } else {
                    Text(' ')
                      .fontSize(10)
                  }
                }
                .width('28%')
                .padding({ top: 12, bottom: 10 })
                .backgroundColor(this.selectedRoles.includes(option.role) ? option.bgColor : AppColors.bgSecondary)
                .borderRadius(12)
                .border({
                  width: this.selectedRoles.includes(option.role) ? 1.5 : 0,
                  color: this.selectedRoles.includes(option.role) ? option.color : Color.Transparent
                })
                .alignItems(HorizontalAlign.Center)
                .onClick(() => this.toggleRole(option.role))
              },
              (option: RoleOption) => option.role
            )
          }
          .width('90%')
          .justifyContent(FlexAlign.SpaceBetween)

          // æ‰‹æœºå·
          TextInput({ placeholder: 'æ‰‹æœºå·', text: $$this.phone })
            .width('90%')
            .height(48)
            .fontSize(15)
            .type(InputType.Number)
            .maxLength(11)
            .backgroundColor(AppColors.card)
            .borderRadius(12)
            .padding({ left: 14, right: 14 })

          // å§“å
          TextInput({ placeholder: 'å§“å', text: $$this.name })
            .width('90%')
            .height(48)
            .fontSize(15)
            .backgroundColor(AppColors.card)
            .borderRadius(12)
            .padding({ left: 14, right: 14 })

          // å¯†ç 
          TextInput({ placeholder: 'å¯†ç ', text: $$this.password })
            .width('90%')
            .height(48)
            .fontSize(15)
            .type(InputType.Password)
            .maxLength(20)
            .backgroundColor(AppColors.card)
            .borderRadius(12)
            .padding({ left: 14, right: 14 })

          // æ¡ä»¶ï¼šåŒ…å«æ•‘æ´æˆ–æŒ‡æŒ¥è§’è‰²æ—¶éœ€é€‰æ‹©å•ä½
          if (this.hasNonCitizenRole()) {
            Text('æ‰€å±žå•ä½')
              .fontSize(14)
              .fontWeight(FontWeight.Medium)
              .fontColor(AppColors.textSecondary)
              .width('90%')
              .margin({ top: 4 })

            Select(this.unitOptions)
              .selected(this.unitIndex)
              .onSelect((index: number) => {
                this.unitIndex = index;
              })
              .width('90%')
              .height(48)
              .font({ size: 15 })
              .backgroundColor(AppColors.card)
              .borderRadius(12)
          }

          // é”™è¯¯ä¿¡æ¯
          if (this.errorMsg) {
            Text(this.errorMsg)
              .fontSize(13)
              .fontColor(AppColors.danger)
              .width('90%')
              .margin({ top: 4 })
          }

          // æ³¨å†ŒæŒ‰é’®
          Button(this.isLoading ? 'æ³¨å†Œä¸­...' : 'æ³¨å†Œ')
            .width('90%')
            .height(48)
            .fontSize(16)
            .fontWeight(FontWeight.Medium)
            .fontColor(Color.White)
            .backgroundColor(this.isLoading ? '#7BA9FF' : AppColors.primary)
            .borderRadius(24)
            .margin({ top: 16, bottom: 24 })
            .enabled(!this.isLoading)
            .onClick(() => this.handleRegister())
        }
        .width('100%')
        .alignItems(HorizontalAlign.Center)
      }
      .layoutWeight(1)
      .scrollBar(BarState.Off)
      .width('100%')
    }
    .width('100%')
    .height('100%')
    .backgroundColor(AppColors.bg)
  }
}

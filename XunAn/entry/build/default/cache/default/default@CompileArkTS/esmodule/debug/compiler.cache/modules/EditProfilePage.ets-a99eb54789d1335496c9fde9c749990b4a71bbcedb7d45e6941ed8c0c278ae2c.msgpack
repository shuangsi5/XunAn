      if (this.newPassword !== this.confirmPassword) {
        this.errorMsg = 'ä¸¤æ¬¡è¾“å…¥çš„å¯†ç ä¸ä¸€è‡´';
        return;
      }
    } else if (this.field === 'phone') {
      // ä¿®æ”¹æ‰‹æœºå·æ ¡éªŒ
      let newPhone = this.value.trim();
      if (!newPhone) {
        this.errorMsg = 'è¯·è¾“å…¥æ‰‹æœºå·';

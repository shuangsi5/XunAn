      .slide(SlideEffect.Right)
    PageTransitionExit({ duration: 400, curve: Curve.Friction, type: RouteType.Push })
      .slide(SlideEffect.Left)
      .opacity(0.6)
    PageTransitionEnter({ duration: 400, curve: Curve.Friction, type: RouteType.Pop })
      .slide(SlideEffect.Left)
    PageTransitionExit({ duration: 400, curve: Curve.Friction, type: RouteType.Pop })
      .slide(SlideEffect.Right)
      .opacity(0.6)
  }

  build() {
    if (this.currentUser) {
      // ===== å·²ç™»å½•çŠ¶æ€ï¼ˆè‡ªåŠ¨è·³è½¬åé€šå¸¸ä¸ä¼šåœç•™åœ¨æ­¤ï¼‰=====
      Column({ space: 8 }) {
        // ç”¨æˆ·ä¿¡æ¯æ 
        Row() {
          Column({ space: 2 }) {
            Text(`æ¬¢è¿ï¼Œ${this.currentUser!.name}`)
              .fontSize(16)
              .fontWeight(FontWeight.Bold)
              .fontColor(AppColors.textPrimary)
            if (this.currentUser!.unit) {
              Text(`æ‰€å±ï¼š${this.currentUser!.unit}`)
                .fontSize(12)
                .fontColor(AppColors.textTertiary)
            }
          }
          .alignItems(HorizontalAlign.Start)

          Blank()

          Button('ğŸ‘¤ ä¸ªäººä¸­å¿ƒ')
            .fontSize(13)
            .height(32)
            .fontColor(Color.White)
            .backgroundColor(AppColors.primary)
            .borderRadius(16)
            .margin({ right: 8 })
            .onClick(() => this.goToProfile())

          Button('é€€å‡ºç™»å½•')
            .fontSize(13)
            .height(32)
            .fontColor(Color.White)
            .backgroundColor(AppColors.danger)
            .borderRadius(16)
            .onClick(() => this.logout())
        }
        .width('85%')
        .padding({ top: 16, bottom: 4 })

        // åˆ†éš”æç¤º
        Text('è¯·é€‰æ‹©æ‚¨çš„èº«ä»½')
          .fontSize(14)
          .fontColor(AppColors.textSecondary)
          .width('85%')
          .margin({ top: 8, bottom: 4 })

        // è§’è‰²å¡ç‰‡ - æŒ‰ displayRoles é¡ºåºæ˜¾ç¤º
        ForEach(this.displayRoles, (role: Role) => {
          Column({ space: 4 }) {
            Text(getRoleEmoji(role))
              .fontSize(40)
            Text(getRoleLabel(role))
              .fontSize(18)
              .fontWeight(FontWeight.Bold)
              .fontColor(AppColors.textPrimary)
            Text(getRoleSubtitle(role))
              .fontSize(11)
              .fontColor(AppColors.textTertiary)
          }
          .width('80%')
          .padding(16)
          .backgroundColor(getRoleBgColor(role))
          .borderRadius(16)
          .onClick(() => this.selectRole(role))
        }, (role: Role) => role.toString())

        Blank()
          .height(8)
      }
      .width('100%')
      .height('100%')
      .backgroundColor(AppColors.bg)
      .alignItems(HorizontalAlign.Center)

    } else {
      // ===== æœªç™»å½•çŠ¶æ€ =====
      Column({ space: 16 }) {
        Text('ğŸŒŠ')
          .fontSize(56)
          .margin({ top: 16 })

        Text('æ™ºæ…§é˜²æ±›åº”æ€¥æ•‘æ´ç³»ç»Ÿ')
          .fontSize(24)
          .fontWeight(FontWeight.Bold)
          .fontColor(AppColors.primary)

        Text('â€”â€” æ±›å®‰ â€”â€”')
          .fontSize(16)
          .fontColor(AppColors.textSecondary)

        Text('è¯·ç™»å½•ä»¥ç»§ç»­')
          .fontSize(14)
          .fontColor(AppColors.textSecondary)
          .margin({ top: 8, bottom: 4 })

        Button('ç™»å½•')
          .width('80%')
          .height(48)
          .fontSize(16)
          .fontWeight(FontWeight.Medium)
          .fontColor(Color.White)
          .backgroundColor(AppColors.primary)
          .borderRadius(24)
          .onClick(() => this.goToLogin())

        Button('å¿«é€Ÿæ±‚æ•‘')
          .width('80%')
          .height(48)
          .fontSize(16)
          .fontWeight(FontWeight.Medium)
          .fontColor(Color.White)
          .backgroundColor(AppColors.danger)
          .borderRadius(24)
          .onClick(() => this.goToQuickSOS())

        Blank()
          .height(8)
      }
      .width('100%')
      .height('100%')
      .backgroundColor(AppColors.bg)
      .justifyContent(FlexAlign.Center)
      .alignItems(HorizontalAlign.Center)
    }
  }
}

import { chatWithAi, ChatMessageItem } from '../utils/ApiService';
import { AppColors } from '../common/Theme';

interface ChatMessage {
  id: number;
  role: string; // 'user' | 'assistant'
  content: string;
}

@Entry
@Component
struct AiChatPage {
  @State messages: ChatMessage[] = [];
  @State inputText: string = '';
  @State isLoading: boolean = false;
  private nextId: number = 1;
  private scroller: Scroller = new Scroller();

  scrollToBottom(): void {
    this.scroller.scrollEdge(Edge.Bottom);
  }

  async send(): Promise<void> {
    const text = this.inputText.trim();
    if (text.length === 0 || this.isLoading) {
      return;
    }

    // è¿½åŠ ç”¨æˆ·æ¶ˆæ¯
    this.messages.push({ id: this.nextId++, role: 'user', content: text });
    this.inputText = '';
    this.isLoading = true;
    this.scrollToBottom();

    try {
      // æºå¸¦å®Œæ•´ä¸Šä¸‹æ–‡ï¼Œäº¤ç»™æœåŠ¡ç«¯æ‹¼æ¥ system æç¤ºè¯
      const apiMessages: ChatMessageItem[] = this.messages.map((m: ChatMessage): ChatMessageItem => {
        return { role: m.role, content: m.content };
      });
      const reply = await chatWithAi(apiMessages);
      if (reply) {
        this.messages.push({ id: this.nextId++, role: 'assistant', content: reply });
      } else {
        this.messages.push({ id: this.nextId++, role: 'assistant', content: 'æŠ±æ­‰ï¼ŒAI æœåŠ¡æš‚æ—¶ä¸å¯ç”¨ï¼Œè¯·ç¨åé‡è¯•ã€‚' });
      }
    } catch (err) {
      console.error('AI å¯¹è¯å¤±è´¥', JSON.stringify(err));
      this.messages.push({ id: this.nextId++, role: 'assistant', content: 'ç½‘ç»œå¼‚å¸¸ï¼Œè¯·ç¨åé‡è¯•ã€‚' });
    } finally {
      this.isLoading = false;
      this.scrollToBottom();
    }
  }

  @Builder
  MessageBubble(item: ChatMessage) {
    if (item.role === 'user') {
      Row() {
        Blank()
        Text(item.content)
          .fontSize(15)
          .fontColor(Color.White)
          .backgroundColor(AppColors.primary)
          .borderRadius({ topLeft: 16, topRight: 4, bottomLeft: 16, bottomRight: 16 })
          .padding(12)
          .constraintSize({ maxWidth: '78%' })
      }
      .width('100%')
    } else {
      Row({ space: 8 }) {
        Text('ğŸ¤–')
          .fontSize(20)
        Text(item.content)
          .fontSize(15)
          .fontColor(AppColors.textPrimary)
          .backgroundColor(AppColors.card)
          .borderRadius({ topLeft: 4, topRight: 16, bottomLeft: 16, bottomRight: 16 })
          .padding(12)
          .constraintSize({ maxWidth: '78%' })
        Blank()
      }
      .width('100%')
      .alignItems(VerticalAlign.Top)
    }
  }

  // é¸¿è’™åŸç”Ÿå¼é¡µé¢è½¬åœºï¼špush ä»å³æ»‘å…¥ã€pop ä»å·¦è¿”å›ï¼Œæ—§é¡µé¢æ·¡å‡ºå½¢æˆè§†å·®
  pageTransition() {
    PageTransitionEnter({ duration: 400, curve: Curve.Friction, type: RouteType.Push })
      .slide(SlideEffect.Right)
    PageTransitionExit({ duration: 400, curve: Curve.Friction, type: RouteType.Push })
      .slide(SlideEffect.Left)

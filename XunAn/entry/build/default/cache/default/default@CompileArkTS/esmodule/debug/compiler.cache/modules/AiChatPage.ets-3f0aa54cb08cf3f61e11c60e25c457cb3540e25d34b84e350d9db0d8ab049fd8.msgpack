          .padding(12)
          .constraintSize({ maxWidth: '78%' })
      }
      .width('100%')
    } else {
      Row({ space: 8 }) {
        Text('ğŸ¤–')
          .fontSize(20)
        Text(item.content)
          .fontSize(15)

      return;
    }
    // å…ˆæ¸…é™¤å·²æœ‰è¦†ç›–ç‰©ï¼Œé¿å…é‡å¤æ·»åŠ 
    this.mapController.clear();
    // æ·»åŠ æ ‡è®°ï¼šæ ‡è®°é»˜è®¤ä¸å¯ç‚¹å‡»ï¼Œéœ€è¦æ˜¾å¼å¼€å¯ clickable
    this.markers.forEach((marker: MapMarker) => {
      const options: mapCommon.MarkerOptions = {
        position: { latitude: marker.position.latitude, longitude: marker.position.longitude },
        clickable: true
      };
      if (marker.title) {
        options.title = marker.title;
      }
      if (marker.snippet) {
        options.snippet = marker.snippet;
      }
      this.mapController!.addMarker(options).then((m: map.Marker) => {
        // ç”¨ tag è®°å½•æ ‡è®°å¯¹åº”çš„æ±‚æ•‘è®°å½•IDï¼Œä¾›ç‚¹å‡»å›è°ƒè¯†åˆ«
        if (marker.id) {
          m.setTag(marker.id);
        }
      }).catch((err: Error) => {
        console.error('æ·»åŠ åœ°å›¾æ ‡è®°å¤±è´¥: ' + JSON.stringify(err));
      });
    });
    // æ·»åŠ æŠ˜çº¿
    this.polylines.forEach((line: MapPolyline) => {
      this.mapController!.addPolyline(line).catch((err: Error) => {
        console.error('æ·»åŠ åœ°å›¾æŠ˜çº¿å¤±è´¥: ' + JSON.stringify(err));
      });
    });
    // æ˜¯å¦æ˜¾ç¤ºæˆ‘çš„ä½ç½®å›¾å±‚
    if (this.myLocationEnabled) {
      this.mapController!.setMyLocationEnabled(true);
      this.mapController!.setMyLocationControlsEnabled(true);
    }
  }

  build() {
    Stack() {
      HMSMap({
        mapOptions: this.mapOptions,
        mapCallback: (err, controller) => {
          if (!err && controller) {
            this.mapController = controller;
            // ç›‘å¬æ ‡è®°ç‚¹å‡»äº‹ä»¶ï¼Œå›ä¼ æ ‡è®°çš„ tagï¼ˆå³æ±‚æ•‘è®°å½•IDï¼‰
            controller.on('markerClick', (marker: map.Marker) => {
              const tag = marker.getTag();
              if (this.onMarkerClick && tag !== null && tag !== undefined) {
                this.onMarkerClick(String(tag));
              }
            });
            // åˆæ¬¡åŒæ­¥ï¼ˆå¤„ç† markers/polylines åœ¨æ§åˆ¶å™¨å°±ç»ªå‰å·²è®¾ç½®çš„æƒ…å†µï¼‰
            this.syncToMap();
            // å°†æ§åˆ¶å™¨æš´éœ²ç»™çˆ¶ç»„ä»¶ï¼Œæ–¹ä¾¿åç»­å¼‚æ­¥æ“ä½œ
            if (this.onControllerReady) {
              this.onControllerReady(controller);
            }
          }
        }
      })
        .width('100%')
        .height('100%')
    }
    .width('100%')
    .height('100%')
  }
}

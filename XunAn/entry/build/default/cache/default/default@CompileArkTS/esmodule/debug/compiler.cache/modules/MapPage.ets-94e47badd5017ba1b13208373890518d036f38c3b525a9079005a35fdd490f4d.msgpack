    // å…¨å±€æ¨¡å¼ï¼šåœ¨åœ°å›¾ä¸Šæ˜¾ç¤ºæ‰€æœ‰æ±‚æ•‘ç‚¹
    loadGlobalMarkers() {
        getSOSList().then((sosList) => {
            this.sosList = sosList;
            let markers = [];
            for (let sos of sosList) {
                markers.push({
                    position: { latitude: sos.latitude, longitude: sos.longitude },
                    title: sos.name,
                    snippet: `${sos.status} Â· ${sos.address}`,
                    id: sos.id
                });
            }
            this.markers = markers;
        });
    }
    // ç‚¹å‡»æ•‘æ´ç‚¹æ ‡è®°ï¼šå±•ç¤ºæ±‚æ•‘äººå‘˜ä¿¡æ¯
    onMarkerClick(markerId) {
        if (!markerId || markerId === 'my-location') {
            return;
        }
        let sos = this.sosList.find((item) => item.id === markerId);
        if (sos) {
            this.selectedSOS = sos;
        }
        else {
            // åˆ—è¡¨å°šæœªåŠ è½½å®Œæˆæˆ–è®°å½•è¾ƒæ–°ï¼Œé‡æ–°æ‹‰å–ä¸€æ¬¡å†åŒ¹é…
            getSOSList().then((list) => {
                this.sosList = list;
                let found = list.find((item) => item.id === markerId);
                if (found) {
                    this.selectedSOS = found;
                }
            });
        }
    }
    async fetchMyLocationForSOS(sosId) {
        this.locating = true;
        let ctx = getContext(this);
        let pos = await getCurrentPosition(ctx);
        // å°†è‡ªèº«ä½ç½®è¿½åŠ åˆ°æ ‡è®°åˆ—è¡¨ï¼Œä¸æ±‚æ•‘æ ‡è®°æ˜¾ç¤ºåœ¨åŒä¸€åœ°å›¾ä¸Š
        this.markers = [

            .onClick(() => this.showAssignDialog = false)
        }
        .width('85%')
        .height('60%')
        .padding(24)
        .backgroundColor(AppColors.card)
        .borderRadius(20)
        .shadow({ radius: 24, color: 'rgba(0,0,0,0.2)' })
      }

      // ========== èº«ä»½åˆ‡æ¢å¼¹çª— ==========
      if (this.showRoleSwitchDialog) {

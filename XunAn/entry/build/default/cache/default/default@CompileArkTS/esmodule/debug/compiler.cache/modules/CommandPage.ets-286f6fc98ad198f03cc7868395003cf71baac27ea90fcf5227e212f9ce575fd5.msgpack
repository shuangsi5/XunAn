        // ç»Ÿè®¡ç­›é€‰å¡ç‰‡ï¼ˆä¸Šæ»‘æ”¶èµ·ï¼Œä¸‹æ»‘å±•å¼€ï¼‰
        Row({ space: 8 }) {
          this.FilterItem('å…¨éƒ¨', AppColors.primary, 0)
          this.FilterItem('å¾…æ•‘æ´', AppColors.danger, 1)
          this.FilterItem('æ•‘æ´ä¸­', AppColors.warning, 2)
          this.FilterItem('å·²å®Œæˆ', AppColors.success, 3)
        }
        .width('90%')
        .margin({
          top: this.statsHeight > 0 ? 8 : 0,
          bottom: this.statsHeight > 0 ? 16 : 0
        })
        .height(this.statsHeight)
        .opacity(this.statsHeight / STATS_FULL_HEIGHT)
        .clip(true)
        .animation({ duration: 150, curve: Curve.EaseInOut })

        Button('æŸ¥çœ‹å…¨å±€åœ°å›¾')
          .width('90%')
          .height(40)
          .fontSize(14)
          .fontWeight(FontWeight.Medium)
          .fontColor(Color.White)
          .backgroundColor(AppColors.primary)
          .borderRadius(20)
          .margin({ bottom: 16 })
          .onClick(() => {
            router.pushUrl({ url: 'pages/MapPage' });
          })

        Row() {
          Text('æ±‚æ•‘ä¿¡æ¯åˆ—è¡¨')
            .fontSize(16)
            .fontWeight(FontWeight.Bold)
            .fontColor(AppColors.textPrimary)
          Blank()
          Text(`å…± ${this.getFilteredList().length} æ¡`)
            .fontSize(12)
            .fontColor(AppColors.textTertiary)
        }
        .width('90%')
        .margin({ bottom: 12 })

        if (this.getFilteredList().length === 0) {
          Column({ space: 8 }) {
            Text('ğŸ“­')
              .fontSize(40)
            Text('æš‚æ— æ±‚æ•‘ä¿¡æ¯')
              .fontSize(14)
              .fontColor(AppColors.textTertiary)
          }
          .width('100%')
          .layoutWeight(1)
          .justifyContent(FlexAlign.Center)
        } else {
          List({ space: 12 }) {
            ForEach(this.getFilteredList(), (item: SOSInfo) => {
              ListItem() {
                SOSCard({
                  sos: item,
                  onAssign: item.status === SOSStatus.PENDING ? ((): void => this.openAssign(item)) : undefined,
                  onDetail: (): void => {
                    router.pushUrl({
                      url: 'pages/SOSDetailPage',

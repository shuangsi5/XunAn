            this.handleScrollIndex(firstIndex);
          })
        }

        BottomNavBar({ activeTab: 0 })
      }
      .width('100%')
      .height('100%')
      .backgroundColor(AppColors.bg)
      .alignItems(HorizontalAlign.Center)

      if (this.showAssignDialog) {
        Column() {
          Text('é€‰æ‹©æ•‘æ´äººå‘˜')
            .fontSize(18)
            .fontWeight(FontWeight.Bold)

            .padding({ left: 10, right: 10 })

          if (this.errorMsg) {
            Text(this.errorMsg)
              .fontSize(11)
              .fontColor(AppColors.danger)
          }

          Button(this.isLoading ? 'ç™»å½•ä¸­...' : 'ç™»å½•')
            .width('100%')

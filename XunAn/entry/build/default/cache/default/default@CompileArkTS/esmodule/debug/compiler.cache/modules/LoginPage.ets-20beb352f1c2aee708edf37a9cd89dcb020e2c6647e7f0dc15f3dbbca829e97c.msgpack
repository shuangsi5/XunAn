      .slide(SlideEffect.Left)
    PageTransitionExit({ duration: 400, curve: Curve.Friction, type: RouteType.Pop })
      .slide(SlideEffect.Right)
      .opacity(0.6)
  }

  build() {
    if (this.isWatch) {
      this.buildWatch()
    } else {
      this.buildPhone()
    }
  }

  // ===== æ‰‹æœº/å¹³æ¿ =====
  @Builder
  buildPhone() {
    Column({ space: 16 }) {
      // å“ç‰Œæ ‡è¯†
      Text('ðŸŒŠ')
        .fontSize(56)
        .margin({ top: 16 })

      Text('æ±›å®‰')
        .fontSize(26)
        .fontWeight(FontWeight.Bold)
        .fontColor(AppColors.primary)

      Text('æ™ºæ…§é˜²æ±›åº”æ€¥æ•‘æ´ç³»ç»Ÿ')
        .fontSize(13)
        .fontColor(AppColors.textSecondary)

      // è¾“å…¥åŒºåŸŸå¡ç‰‡
      Column({ space: 12 }) {
        TextInput({ placeholder: 'è¯·è¾“å…¥æ‰‹æœºå·', text: $$this.phone })
          .width('100%')
          .height(48)
          .fontSize(15)
          .type(InputType.Number)
          .maxLength(11)
          .backgroundColor(AppColors.bgSecondary)
          .borderRadius(12)
          .padding({ left: 14, right: 14 })

        TextInput({ placeholder: 'è¯·è¾“å…¥å¯†ç ', text: $$this.password })
          .width('100%')
          .height(48)
          .fontSize(15)
          .type(InputType.Password)
          .maxLength(20)
          .backgroundColor(AppColors.bgSecondary)
          .borderRadius(12)
          .padding({ left: 14, right: 14 })

        if (this.errorMsg) {
          Text(this.errorMsg)
            .fontSize(13)
            .fontColor(AppColors.danger)
        }

        Button(this.isLoading ? 'ç™»å½•ä¸­...' : 'ç™»å½•')
          .width('100%')
          .height(48)
          .fontSize(16)
          .fontWeight(FontWeight.Medium)
          .fontColor(Color.White)
          .backgroundColor(this.isLoading ? '#7BA9FF' : AppColors.primary)
          .borderRadius(24)
          .margin({ top: 4 })
          .enabled(!this.isLoading)
          .onClick(() => this.handleLogin())
      }
      .width('86%')
      .padding(20)
      .backgroundColor(AppColors.card)
      .borderRadius(20)
      .shadow({ radius: 12, color: 'rgba(0,0,0,0.06)' })

      // å¿«é€Ÿæ±‚æ•‘æŒ‰é’®
      Button('å¿«é€Ÿæ±‚æ•‘')
        .width('86%')
        .height(48)
        .fontSize(16)
        .fontWeight(FontWeight.Medium)
        .fontColor(Color.White)
        .backgroundColor(AppColors.danger)
        .borderRadius(24)
        .onClick(() => this.handleQuickSOS())

      // æ³¨å†Œé“¾æŽ¥
      Row() {
        Text('è¿˜æ²¡æœ‰è´¦å·ï¼Ÿ')
          .fontSize(13)
          .fontColor(AppColors.textTertiary)
        Text('æ³¨å†Œè´¦å·')
          .fontSize(13)
          .fontColor(AppColors.primary)
          .onClick(() => {
            router.pushUrl({ url: 'pages/RegisterPage' });
          })
      }
    }
    .width('100%')
    .height('100%')
    .backgroundColor(AppColors.bg)
    .justifyContent(FlexAlign.Center)
    .alignItems(HorizontalAlign.Center)
  }

  // ===== æ‰‹è¡¨ï¼ˆç´§å‡‘ + å¯æ»šåŠ¨ï¼Œé€‚é…åœ†å½¢å°å±ï¼‰=====
  @Builder
  buildWatch() {
    Scroll() {
      Column({ space: 10 }) {
        Text('ðŸŒŠ')
          .fontSize(28)

        Text('æ±›å®‰')
          .fontSize(18)
          .fontWeight(FontWeight.Bold)
          .fontColor(AppColors.primary)

        Text('æ™ºæ…§é˜²æ±›åº”æ€¥æ•‘æ´ç³»ç»Ÿ')
          .fontSize(11)
          .fontColor(AppColors.textSecondary)

        // è¾“å…¥åŒºåŸŸå¡ç‰‡
        Column({ space: 8 }) {
          TextInput({ placeholder: 'è¯·è¾“å…¥æ‰‹æœºå·', text: $$this.phone })
            .width('100%')
            .height(38)
            .fontSize(13)
            .type(InputType.Number)
            .maxLength(11)
            .backgroundColor(AppColors.bgSecondary)
            .borderRadius(10)
            .padding({ left: 10, right: 10 })

          TextInput({ placeholder: 'è¯·è¾“å…¥å¯†ç ', text: $$this.password })
            .width('100%')
            .height(38)
            .fontSize(13)
            .type(InputType.Password)
            .maxLength(20)

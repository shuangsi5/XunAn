async function request(method, path, body, readTimeoutMs = 10000) {
    const httpRequest = http.createHttp();
    try {
        const opts = {
            method: method,
            header: { 'Content-Type': 'application/json' },
            expectDataType: http.HttpDataType.STRING,
            connectTimeout: 10000,
            readTimeout: readTimeoutMs
        };
        if (body) {
            opts.extraData = JSON.stringify(body);
        }
        const resp = await httpRequest.request(BASE_URL + path, opts);
        const data = JSON.parse(resp.result);
        httpRequest.destroy();
        return data;
    }
    catch (err) {
        httpRequest.destroy();
        return {
            success: false,
            message: err.message || 'ç½‘ç»œè¯·æ±‚å¤±è´¥'
        };
    }
}
async function get(path) {
    return request(http.RequestMethod.GET, path);
}
async function post(path, body, readTimeoutMs = 10000) {
    return request(http.RequestMethod.POST, path, body, readTimeoutMs);
}
async function put(path, body) {
    return request(http.RequestMethod.PUT, path, body);
}

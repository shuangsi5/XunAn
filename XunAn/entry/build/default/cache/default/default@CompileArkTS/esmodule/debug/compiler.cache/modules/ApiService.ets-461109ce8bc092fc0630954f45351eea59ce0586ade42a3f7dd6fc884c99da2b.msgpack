export async function getUsers(): Promise<User[]> {
  return [];
}

export async function registerUser(
  phone: string,
  name: string,
  password: string,
  roles: Role[],
  unit: string = ''
): Promise<boolean> {
  const body: RegisterBody = {
    phone: phone,
    name: name,
    password: password,
    roles: roles,
    unit: unit
  };
  const result: ApiResponse = await post('/auth/register', body);
  return result.success === true;
}

export class LoginResult {
  user: User | null;
  error: string;

  constructor(user: User | null, error: string = '') {
    this.user = user;
    this.error = error;
  }
}

export async function loginUser(phone: string, password: string): Promise<LoginResult> {
  const body: LoginBody = {
    phone: phone,
    password: password
  };
  const result: ApiResponse = await post('/auth/login', body);
  if (result.success === true && result.user) {
    const userData = result.user as RawUserItem;
    return new LoginResult(new User(
      userData.phone,
      userData.name,
      userData.password,
      userData.roles as Role[],
      userData.unit || ''
    ));
  }
  return new LoginResult(null, (result as ErrorResponse).message || 'æ‰‹æœºå·æˆ–å¯†ç é”™è¯¯');
}

export async function getUserByPhone(phone: string): Promise<User | null> {
  const result: ApiResponse = await get(`/user/${phone}`);
  if (result.success === true && result.user) {
    const userData = result.user as RawUserItem;
    return new User(
      userData.phone,
      userData.name,
      userData.password,
      userData.roles as Role[],
      userData.unit || '',
      userData.avatarUrl || ''
    );
  }
  return null;
}

export async function updateUserProfile(
  phone: string,
  name: string,
  password: string,
  unit: string,
  newPhone: string = '',
  avatarUrl: string = ''
): Promise<boolean> {
  const body: UpdateUserBody = {
    name: name,
    password: password,
    unit: unit,
    newPhone: newPhone,
    avatarUrl: avatarUrl
  };
  const result: ApiResponse = await put(`/user/${phone}`, body);
  return result.success === true;
}


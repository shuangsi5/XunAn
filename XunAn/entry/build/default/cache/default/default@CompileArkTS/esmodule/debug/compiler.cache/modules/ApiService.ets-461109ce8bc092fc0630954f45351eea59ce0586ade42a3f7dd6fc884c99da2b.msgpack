export async function getRescuerList(): Promise<RescuerInfo[]> {
  const result: ApiResponse = await get('/rescuers');
  if (!result.success) {
    return [];
  }
  const data = result.data as Array<RawRescuerItem>;
  if (!data || !Array.isArray(data)) {
    return [];

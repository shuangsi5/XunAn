export class LoginResult {
    constructor(user, error = '') {
        this.user = user;
        this.error = error;
    }
}
export async function loginUser(phone, password) {
    const body = {
        phone: phone,
        password: password
    };
    const result = await post('/auth/login', body);
    if (result.success === true && result.user) {
        const userData = result.user;
        return new LoginResult(new User(userData.phone, userData.name, userData.password, userData.roles, userData.unit || ''));
    }
    return new LoginResult(null, result.message || 'æ‰‹æœºå·æˆ–å¯†ç é”™è¯¯');
}
export async function getUserByPhone(phone) {
    const result = await get(`/user/${phone}`);
    if (result.success === true && result.user) {
        const userData = result.user;
        return new User(userData.phone, userData.name, userData.password, userData.roles, userData.unit || '', userData.avatarUrl || '');
    }
    return null;
}
export async function updateUserProfile(phone, name, password, unit, newPhone = '', avatarUrl = '') {

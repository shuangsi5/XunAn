        name: name,
        password: password,
        unit: unit,
        newPhone: newPhone,
        avatarUrl: avatarUrl
    };
    const result = await put(`/user/${phone}`, body);
    return result.success === true;
}
export async function chatWithAi(messages) {
    const body = { messages: messages };
    const result = await post('/ai/chat', body);
    if (result.success === true && result.data) {
        const data = result.data;
        return data.content || '';
    }
    return '';
}

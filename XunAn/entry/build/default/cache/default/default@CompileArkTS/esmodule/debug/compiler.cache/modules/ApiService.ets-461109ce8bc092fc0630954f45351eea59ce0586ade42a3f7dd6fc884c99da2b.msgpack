        return new SOSInfo(item.id.toString(), item.name, item.phone, item.bloodType || 'æœªçŸ¥', Number(item.latitude) || 0, Number(item.longitude) || 0, item.address || '', item.description || '', item.level, item.status, item.time || '', String(item.assignedRescuerId || ''), item.assignedRescuerName || '', item.category, item.notes || '', item.imageUrl || '');
    });
}

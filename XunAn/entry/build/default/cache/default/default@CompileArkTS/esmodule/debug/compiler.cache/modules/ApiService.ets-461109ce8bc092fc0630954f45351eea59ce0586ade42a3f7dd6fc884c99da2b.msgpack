        console.log('ä¸Šä¼ å“åº”ä½“:', resp.result);
        if (resp.responseCode === 200 && resp.result) {
            let result = JSON.parse(resp.result.toString());
            if (result.success && result.url) {
                return result.url;
            }
            else {
                throw new Error(result.message || 'ä¸Šä¼ å¤±è´¥');
            }
        }
        else {
            throw new Error('æœåŠ¡å™¨å“åº”å¼‚å¸¸: ' + resp.responseCode);
        }
    }
    catch (err) {
        console.error('ä¸Šä¼ å›¾ç‰‡å¼‚å¸¸:', JSON.stringify(err));
        return '';
    }
}

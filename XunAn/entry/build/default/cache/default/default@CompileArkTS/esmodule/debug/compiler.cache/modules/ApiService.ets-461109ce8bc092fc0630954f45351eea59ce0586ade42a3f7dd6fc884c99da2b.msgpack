export async function uploadImage(context, fileUri) {
    try {
        console.log('åŸå§‹ fileUri:', fileUri);
        let uploadFileName = fileUri.substring(fileUri.lastIndexOf('/') + 1);
        if (!uploadFileName || uploadFileName.length === 0) {
            uploadFileName = 'image.jpg';
        }
        // 1. è¯»å–æ–‡ä»¶ä¸º ArrayBuffer
        let file = fileIo.openSync(fileUri, fileIo.OpenMode.READ_ONLY);
        let stat = fileIo.statSync(file.fd);
        let buf = new ArrayBuffer(stat.size);
        fileIo.readSync(file.fd, buf);
        fileIo.closeSync(file);
        // 2. ArrayBuffer -> Base64
        let uint8Array = new Uint8Array(buf);
        let base64Helper = new util.Base64Helper();
        let base64 = base64Helper.encodeToStringSync(uint8Array);
        console.log('æ–‡ä»¶è¯»å–æˆåŠŸï¼Œå¤§å°:', stat.size, 'Base64é•¿åº¦:', base64.length);
        // 3. ç”¨æ™®é€š HTTP POST å‘é€ Base64
        let httpRequest = http.createHttp();
        let resp = await httpRequest.request(BASE_URL + '/upload/base64', {
            method: http.RequestMethod.POST,
            header: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            extraData: JSON.stringify({
                image: base64,
                filename: uploadFileName
            })
        });
        console.log('ä¸Šä¼ å“åº”ç :', resp.responseCode);
        console.log('ä¸Šä¼ å“åº”ä½“:', resp.result);
        if (resp.responseCode === 200 && resp.result) {
            let result = JSON.parse(resp.result.toString());
            if (result.success && result.url) {
                return result.url;
            }
            else {
                throw new Error(result.message || 'ä¸Šä¼ å¤±è´¥');
            }
        }
        else {
            throw new Error('æœåŠ¡å™¨å“åº”å¼‚å¸¸: ' + resp.responseCode);
        }
    }
    catch (err) {
        console.error('ä¸Šä¼ å›¾ç‰‡å¼‚å¸¸:', JSON.stringify(err));
        return '';
    }
}

import { common } from '@kit.AbilityKit';
import picker from '@ohos.file.picker';
import { Role } from '../model/Role';
import { getLoggedInPhone, getUserByPhone, clearLoggedIn, uploadImage, updateUserProfile } from '../utils/ApiService';
import { BottomNavBar } from '../components/BottomNavBar';
import { AppColors, getRoleLabel } from '../common/Theme';

function maskPhone(phone: string): string {
  if (phone.length === 11) {
    return phone.substring(0, 3) + '******' + phone.substring(9);
  }
  return phone;
}

@Entry
@Component
struct ProfilePage {
  @State phone: string = '';
  @State name: string = '';
  @State unit: string = '';
  @State avatarUrl: string = '';
  @State roles: Role[] = [];

  aboutToAppear(): void {
    this.loadUser();
  }

  onPageShow(): void {
    this.loadUser();
  }

  async loadUser(): Promise<void> {
    let phone = getLoggedInPhone();
    console.log('ProfilePage loadUser æ‰‹æœºå·:', phone);
    if (phone) {
      try {
        let user = await getUserByPhone(phone);
        console.log('ProfilePage loadUser è·å–ç”¨æˆ·:', JSON.stringify(user));
        if (user) {
          this.phone = user.phone;
          this.name = user.name;
          this.unit = user.unit || '';
          this.avatarUrl = user.avatarUrl || '';
          this.roles = user.roles;
          console.log('ProfilePage loadUser èµ‹å€¼å name:', this.name, 'unit:', this.unit, 'avatar:', this.avatarUrl);
        } else {
          console.log('ProfilePage loadUser getUserByPhone è¿”å› null');
        }
      } catch (err) {
        console.error('ProfilePage loadUser å¼‚å¸¸:', JSON.stringify(err));
      }
    } else {
      console.log('ProfilePage loadUser æ‰‹æœºå·ä¸ºç©º');
    }
  }

  goToEdit(field: string, value: string): void {
    if (field === '') return;
    router.pushUrl({
      url: 'pages/EditProfilePage',
      params: { field: field, value: value }
    });
  }

  async handleUploadAvatar(): Promise<void> {
    try {
      let photoSelectOptions = new picker.PhotoSelectOptions();
      photoSelectOptions.MIMEType = picker.PhotoViewMIMETypes.IMAGE_TYPE;
      photoSelectOptions.maxSelectNumber = 1;

      let photoPicker = new picker.PhotoViewPicker();
      let result = await photoPicker.select(photoSelectOptions);
      if (result.photoUris && result.photoUris.length > 0) {
        let uri = result.photoUris[0];
        promptAction.showToast({ message: 'æ­£åœ¨ä¸Šä¼ å¤´åƒ...', duration: 2000 });
        let ctx = getContext(this) as common.UIAbilityContext;
        let url = await uploadImage(ctx, uri);
        if (url) {
          // ä¸Šä¼ æˆåŠŸï¼Œæ›´æ–°ç”¨æˆ·å¤´åƒåˆ°æœåŠ¡å™¨
          let ok = await updateUserProfile(this.phone, this.name, '', this.unit, '', url);
          if (ok) {
            this.avatarUrl = url;
            promptAction.showToast({ message: 'å¤´åƒæ›´æ–°æˆåŠŸ', duration: 2000 });
          } else {
            promptAction.showToast({ message: 'å¤´åƒä¿å­˜å¤±è´¥', duration: 2000 });
          }
        } else {
          promptAction.showToast({ message: 'å¤´åƒä¸Šä¼ å¤±è´¥', duration: 2000 });
        }
      }
    } catch (err) {
      console.error('é€‰æ‹©æˆ–ä¸Šä¼ å¤´åƒå¤±è´¥:', JSON.stringify(err as Error));
      promptAction.showToast({ message: 'æ“ä½œå¤±è´¥', duration: 2000 });
    }
  }

  handleLogout(): void {
    promptAction.showDialog({
      title: 'ç¡®è®¤é€€å‡º',
      message: 'ç¡®å®šè¦é€€å‡ºç™»å½•å—ï¼Ÿ',
      buttons: [
        { text: 'å–æ¶ˆ', color: '#999' },
        { text: 'é€€å‡º', color: AppColors.danger }
      ]
    }).then((data) => {
      if (data.index === 1) {
        clearLoggedIn();
        promptAction.showToast({ message: 'å·²é€€å‡ºç™»å½•', duration: 2000 });
        router.replaceUrl({ url: 'pages/LoginPage' });
      }
    }).catch(() => {
      // å–æ¶ˆ
    });
  }

  // é¸¿è’™åŸç”Ÿå¼é¡µé¢è½¬åœºï¼špush ä»å³æ»‘å…¥ã€pop ä»å·¦è¿”å›ï¼Œæ—§é¡µé¢æ·¡å‡ºå½¢æˆè§†å·®
  pageTransition() {
    PageTransitionEnter({ duration: 400, curve: Curve.Friction, type: RouteType.Push })
      .slide(SlideEffect.Right)
    PageTransitionExit({ duration: 400, curve: Curve.Friction, type: RouteType.Push })
      .slide(SlideEffect.Left)
      .opacity(0.6)
    PageTransitionEnter({ duration: 400, curve: Curve.Friction, type: RouteType.Pop })
      .slide(SlideEffect.Left)
    PageTransitionExit({ duration: 400, curve: Curve.Friction, type: RouteType.Pop })
      .slide(SlideEffect.Right)
